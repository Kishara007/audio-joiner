---
import { HireContactActions } from '../components/CopyEmailButton';
import en from '../i18n/en.json';
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://audio-joiner.pages.dev/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Hire Me',
      item: 'https://audio-joiner.pages.dev/hire-me',
    },
  ],
};
---

<BaseLayout
  title={en.meta.hireTitle}
  description={en.meta.hireDescription}
  canonicalPath="/hire-me"
  pageMetaKey="hire"
  schemas={[breadcrumbSchema]}
>
  <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Semantic Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-[#455B6E] dark:text-[#A9C2D1]">
      <ol class="flex items-center gap-2">
        <li>
          <a
            href="/"
            data-i18n="hire.breadcrumbHome"
            class="font-medium transition hover:text-[#167D8D] dark:hover:text-[#B9E4E8]"
          >
            {en.hire.breadcrumbHome}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li
          aria-current="page"
          data-i18n="hire.breadcrumbCurrent"
          class="font-semibold text-[#071B2B] dark:text-[#EEEEEE]"
        >
          {en.hire.breadcrumbCurrent}
        </li>
      </ol>
    </nav>

    <section class="rounded-[28px] border border-[#071B2B]/10 bg-white p-6 shadow-sm dark:border-[#B9E4E8]/15 dark:bg-[#0C273D] sm:p-10">
      <p
        data-i18n="hire.eyebrow"
        class="inline-flex rounded-full bg-[#B9E4E8]/45 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-[#071B2B] dark:bg-[#167D8D]/30 dark:text-[#B9E4E8]"
      >
        {en.hire.eyebrow}
      </p>

      <h1
        data-i18n="hire.h1"
        class="mt-4 text-3xl font-extrabold tracking-tight text-[#071B2B] dark:text-[#EEEEEE] sm:text-4xl"
      >
        {en.hire.h1}
      </h1>

      <p
        data-i18n="hire.intro"
        class="mt-4 text-lg font-semibold text-[#167D8D] dark:text-[#B9E4E8]"
      >
        {en.hire.intro}
      </p>

      <p
        data-i18n="hire.body"
        class="mt-3 text-base leading-relaxed text-[#455B6E] dark:text-[#EEEEEE]/85"
      >
        {en.hire.body}
      </p>

      <!-- 3 Specialization Cards -->
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-[#071B2B]/10 bg-[#EEEEEE]/55 p-5 dark:border-[#B9E4E8]/15 dark:bg-[#051320]">
          <h2
            data-i18n="hire.card1Title"
            class="text-base font-bold text-[#071B2B] dark:text-[#B9E4E8]"
          >
            {en.hire.card1Title}
          </h2>
          <p
            data-i18n="hire.card1Body"
            class="mt-2 text-sm leading-relaxed text-[#455B6E] dark:text-[#A9C2D1]"
          >
            {en.hire.card1Body}
          </p>
        </div>

        <div class="rounded-2xl border border-[#071B2B]/10 bg-[#EEEEEE]/55 p-5 dark:border-[#B9E4E8]/15 dark:bg-[#051320]">
          <h2
            data-i18n="hire.card2Title"
            class="text-base font-bold text-[#071B2B] dark:text-[#B9E4E8]"
          >
            {en.hire.card2Title}
          </h2>
          <p
            data-i18n="hire.card2Body"
            class="mt-2 text-sm leading-relaxed text-[#455B6E] dark:text-[#A9C2D1]"
          >
            {en.hire.card2Body}
          </p>
        </div>

        <div class="rounded-2xl border border-[#071B2B]/10 bg-[#EEEEEE]/55 p-5 dark:border-[#B9E4E8]/15 dark:bg-[#051320]">
          <h2
            data-i18n="hire.card3Title"
            class="text-base font-bold text-[#071B2B] dark:text-[#B9E4E8]"
          >
            {en.hire.card3Title}
          </h2>
          <p
            data-i18n="hire.card3Body"
            class="mt-2 text-sm leading-relaxed text-[#455B6E] dark:text-[#A9C2D1]"
          >
            {en.hire.card3Body}
          </p>
        </div>
      </div>

      <p
        data-i18n="hire.closing"
        class="mt-8 text-lg font-bold text-[#071B2B] dark:text-[#EEEEEE]"
      >
        {en.hire.closing}
      </p>

      <div class="mt-5">
        <HireContactActions client:load />
      </div>
    </section>
  </article>
</BaseLayout>
