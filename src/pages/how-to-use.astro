---
import en from '../i18n/en.json';
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://audio-joiner.pages.dev/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'How to Use',
      item: 'https://audio-joiner.pages.dev/how-to-use',
    },
  ],
};
---

<BaseLayout
  title={en.meta.howToTitle}
  description={en.meta.howToDescription}
  canonicalPath="/how-to-use"
  pageMetaKey="howTo"
  schemas={[breadcrumbSchema]}
>
  <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Semantic Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-[#455B6E] dark:text-[#A9C2D1]">
      <ol class="flex items-center gap-2">
        <li>
          <a
            href="/"
            data-i18n="howTo.breadcrumbHome"
            class="font-medium transition hover:text-[#167D8D] dark:hover:text-[#B9E4E8]"
          >
            {en.howTo.breadcrumbHome}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li
          aria-current="page"
          data-i18n="howTo.breadcrumbCurrent"
          class="font-semibold text-[#071B2B] dark:text-[#EEEEEE]"
        >
          {en.howTo.breadcrumbCurrent}
        </li>
      </ol>
    </nav>

    <header class="mb-10">
      <h1
        data-i18n="howTo.h1"
        class="text-3xl font-extrabold tracking-tight text-[#071B2B] dark:text-[#EEEEEE] sm:text-4xl"
      >
        {en.howTo.h1}
      </h1>
      <p
        data-i18n="howTo.subtitle"
        class="mt-3 text-base leading-relaxed text-[#455B6E] dark:text-[#B9E4E8]/85 sm:text-lg"
      >
        {en.howTo.subtitle}
      </p>
    </header>

    <div class="space-y-6">
      <section class="rounded-2xl border border-[#071B2B]/10 bg-white p-6 dark:border-[#B9E4E8]/15 dark:bg-[#0C273D]">
        <h2 data-i18n="howTo.s1Title" class="text-xl font-bold text-[#167D8D] dark:text-[#B9E4E8]">
          {en.howTo.s1Title}
        </h2>
        <p data-i18n="howTo.s1Body" class="mt-2.5 text-sm leading-relaxed text-[#455B6E] dark:text-[#EEEEEE]/85 sm:text-base">
          {en.howTo.s1Body}
        </p>
      </section>

      <section class="rounded-2xl border border-[#071B2B]/10 bg-white p-6 dark:border-[#B9E4E8]/15 dark:bg-[#0C273D]">
        <h2 data-i18n="howTo.s2Title" class="text-xl font-bold text-[#167D8D] dark:text-[#B9E4E8]">
          {en.howTo.s2Title}
        </h2>
        <p data-i18n="howTo.s2Body" class="mt-2.5 text-sm leading-relaxed text-[#455B6E] dark:text-[#EEEEEE]/85 sm:text-base">
          {en.howTo.s2Body}
        </p>
      </section>

      <section class="rounded-2xl border border-[#071B2B]/10 bg-white p-6 dark:border-[#B9E4E8]/15 dark:bg-[#0C273D]">
        <h2 data-i18n="howTo.s3Title" class="text-xl font-bold text-[#167D8D] dark:text-[#B9E4E8]">
          {en.howTo.s3Title}
        </h2>
        <p data-i18n="howTo.s3Body" class="mt-2.5 text-sm leading-relaxed text-[#455B6E] dark:text-[#EEEEEE]/85 sm:text-base">
          {en.howTo.s3Body}
        </p>
      </section>

      <section class="rounded-2xl border border-[#071B2B]/10 bg-white p-6 dark:border-[#B9E4E8]/15 dark:bg-[#0C273D]">
        <h2 data-i18n="howTo.s4Title" class="text-xl font-bold text-[#167D8D] dark:text-[#B9E4E8]">
          {en.howTo.s4Title}
        </h2>
        <p data-i18n="howTo.s4Body" class="mt-2.5 text-sm leading-relaxed text-[#455B6E] dark:text-[#EEEEEE]/85 sm:text-base">
          {en.howTo.s4Body}
        </p>
      </section>

      <section class="rounded-2xl border border-[#071B2B]/10 bg-white p-6 dark:border-[#B9E4E8]/15 dark:bg-[#0C273D]">
        <h2 data-i18n="howTo.tipsTitle" class="text-xl font-bold text-[#071B2B] dark:text-[#EEEEEE]">
          {en.howTo.tipsTitle}
        </h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-relaxed text-[#455B6E] dark:text-[#A9C2D1] sm:text-base">
          <li data-i18n="howTo.tip1">{en.howTo.tip1}</li>
          <li data-i18n="howTo.tip2">{en.howTo.tip2}</li>
          <li data-i18n="howTo.tip3">{en.howTo.tip3}</li>
          <li data-i18n="howTo.tip4">{en.howTo.tip4}</li>
        </ul>
      </section>

      <section class="rounded-2xl border border-[#167D8D]/30 bg-[#071B2B] p-6 text-[#EEEEEE] dark:border-[#B9E4E8]/25 dark:bg-[#051320]">
        <h2 data-i18n="howTo.privacyBoxTitle" class="text-xl font-bold text-[#B9E4E8]">
          {en.howTo.privacyBoxTitle}
        </h2>
        <p data-i18n="howTo.privacyBoxBody" class="mt-2 text-sm leading-relaxed text-[#EEEEEE]/85 sm:text-base">
          {en.howTo.privacyBoxBody}
        </p>
      </section>
    </div>

    <div class="mt-10">
      <a
        href="/"
        data-i18n="howTo.ctaButton"
        class="inline-flex min-h-[48px] items-center justify-center rounded-full bg-[#167D8D] px-8 py-3 text-base font-bold text-white shadow-md transition hover:bg-[#126977] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#167D8D]"
      >
        {en.howTo.ctaButton}
      </a>
    </div>
  </article>
</BaseLayout>
