---
import { AudioJoinerTool } from '../components/AudioJoinerTool';
import en from '../i18n/en.json';
import BaseLayout from '../layouts/BaseLayout.astro';

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Audio Joiner',
  url: 'https://audio-joiner.pages.dev/',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any (Web Browser)',
  browserRequirements: 'Requires a modern browser with Web Audio API support',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  description: en.meta.homeDescription,
  featureList: [
    'Merge MP3, WAV, OGG, M4A, AAC, and FLAC files client-side',
    'Interactive waveform trimming with precision Start and End controls',
    '3-second equal-power crossfade between adjacent audio tracks',
    'Export 192 kbps MP3 or lossless 16-bit PCM WAV via Web Worker',
    '100% browser-based processing with zero server uploads',
  ],
  author: {
    '@type': 'Person',
    name: 'Kishara Dilshan',
    email: 'kisharadilshan007@gmail.com',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: en.home.faq1Q,
      acceptedAnswer: { '@type': 'Answer', text: en.home.faq1A },
    },
    {
      '@type': 'Question',
      name: en.home.faq2Q,
      acceptedAnswer: { '@type': 'Answer', text: en.home.faq2A },
    },
    {
      '@type': 'Question',
      name: en.home.faq3Q,
      acceptedAnswer: { '@type': 'Answer', text: en.home.faq3A },
    },
    {
      '@type': 'Question',
      name: en.home.faq4Q,
      acceptedAnswer: { '@type': 'Answer', text: en.home.faq4A },
    },
    {
      '@type': 'Question',
      name: en.home.faq5Q,
      acceptedAnswer: { '@type': 'Answer', text: en.home.faq5A },
    },
    {
      '@type': 'Question',
      name: en.home.faq6Q,
      acceptedAnswer: { '@type': 'Answer', text: en.home.faq6A },
    },
  ],
};
---

<BaseLayout
  title={en.meta.homeTitle}
  description={en.meta.homeDescription}
  canonicalPath="/"
  pageMetaKey="home"
  schemas={[softwareSchema, faqSchema]}
>
  <!-- FIRST VIEWPORT HERO WORKSPACE (Focal container, no scrolling required) -->
  <section
    aria-labelledby="hero-heading"
    class="mx-auto flex min-h-[calc(100vh-4.5rem)] max-w-6xl flex-col justify-center px-3 py-5 sm:px-6 sm:py-8"
  >
    <div class="mx-auto mb-5 max-w-3xl text-center sm:mb-7">
      <h1
        id="hero-heading"
        data-i18n="tool.h1"
        class="text-2xl font-extrabold tracking-tight text-[#071B2B] dark:text-[#EEEEEE] sm:text-4xl"
      >
        {en.tool.h1}
      </h1>
      <p
        data-i18n="tool.heroSubtitle"
        class="mt-2.5 text-sm leading-relaxed text-[#455B6E] dark:text-[#B9E4E8]/85 sm:text-base"
      >
        {en.tool.heroSubtitle}
      </p>
    </div>

    <AudioJoinerTool client:load />
  </section>

  <!-- BELOW-THE-FOLD HELPFUL CONTENT SECTIONS -->
  <div class="mx-auto max-w-5xl space-y-14 px-4 pt-6 pb-8 sm:px-6 sm:pt-12">
    <!-- 3 Steps Section -->
    <section aria-labelledby="steps-heading">
      <div class="max-w-3xl">
        <h2
          id="steps-heading"
          data-i18n="home.stepsHeading"
          class="text-2xl font-extrabold tracking-tight text-[#071B2B] dark:text-[#EEEEEE] sm:text-3xl"
        >
          {en.home.stepsHeading}
        </h2>
        <p
          data-i18n="home.stepsIntro"
          class="mt-3 text-base leading-relaxed text-[#455B6E] dark:text-[#A9C2D1]"
        >
          {en.home.stepsIntro}
        </p>
      </div>

      <div class="mt-7 grid gap-5 md:grid-cols-3">
        <article class="rounded-2xl border border-[#071B2B]/10 bg-white p-6 shadow-xs dark:border-[#B9E4E8]/15 dark:bg-[#0C273D]">
          <h3
            data-i18n="home.step1Title"
            class="text-lg font-bold text-[#167D8D] dark:text-[#B9E4E8]"
          >
            {en.home.step1Title}
          </h3>
          <p
            data-i18n="home.step1Body"
            class="mt-2.5 text-sm leading-relaxed text-[#455B6E] dark:text-[#EEEEEE]/85"
          >
            {en.home.step1Body}
          </p>
        </article>

        <article class="rounded-2xl border border-[#071B2B]/10 bg-white p-6 shadow-xs dark:border-[#B9E4E8]/15 dark:bg-[#0C273D]">
          <h3
            data-i18n="home.step2Title"
            class="text-lg font-bold text-[#167D8D] dark:text-[#B9E4E8]"
          >
            {en.home.step2Title}
          </h3>
          <p
            data-i18n="home.step2Body"
            class="mt-2.5 text-sm leading-relaxed text-[#455B6E] dark:text-[#EEEEEE]/85"
          >
            {en.home.step2Body}
          </p>
        </article>

        <article class="rounded-2xl border border-[#071B2B]/10 bg-white p-6 shadow-xs dark:border-[#B9E4E8]/15 dark:bg-[#0C273D]">
          <h3
            data-i18n="home.step3Title"
            class="text-lg font-bold text-[#167D8D] dark:text-[#B9E4E8]"
          >
            {en.home.step3Title}
          </h3>
          <p
            data-i18n="home.step3Body"
            class="mt-2.5 text-sm leading-relaxed text-[#455B6E] dark:text-[#EEEEEE]/85"
          >
            {en.home.step3Body}
          </p>
        </article>
      </div>
    </section>

    <!-- Core Capabilities Grid -->
    <section aria-label="Core capabilities" class="grid gap-6 md:grid-cols-2">
      <article class="rounded-2xl border border-[#071B2B]/10 bg-white p-6 dark:border-[#B9E4E8]/15 dark:bg-[#0C273D]">
        <h2
          data-i18n="home.easyTitle"
          class="text-xl font-bold text-[#071B2B] dark:text-[#EEEEEE]"
        >
          {en.home.easyTitle}
        </h2>
        <p
          data-i18n="home.easyBody"
          class="mt-2.5 text-sm leading-relaxed text-[#455B6E] dark:text-[#A9C2D1] sm:text-base"
        >
          {en.home.easyBody}
        </p>
      </article>

      <article class="rounded-2xl border border-[#071B2B]/10 bg-white p-6 dark:border-[#B9E4E8]/15 dark:bg-[#0C273D]">
        <h2
          data-i18n="home.unlimitedTitle"
          class="text-xl font-bold text-[#071B2B] dark:text-[#EEEEEE]"
        >
          {en.home.unlimitedTitle}
        </h2>
        <p
          data-i18n="home.unlimitedBody"
          class="mt-2.5 text-sm leading-relaxed text-[#455B6E] dark:text-[#A9C2D1] sm:text-base"
        >
          {en.home.unlimitedBody}
        </p>
      </article>

      <article class="rounded-2xl border border-[#071B2B]/10 bg-white p-6 dark:border-[#B9E4E8]/15 dark:bg-[#0C273D]">
        <h2
          data-i18n="home.crossfadeTitle"
          class="text-xl font-bold text-[#071B2B] dark:text-[#EEEEEE]"
        >
          {en.home.crossfadeTitle}
        </h2>
        <p
          data-i18n="home.crossfadeBody"
          class="mt-2.5 text-sm leading-relaxed text-[#455B6E] dark:text-[#A9C2D1] sm:text-base"
        >
          {en.home.crossfadeBody}
        </p>
      </article>

      <article class="rounded-2xl border border-[#167D8D]/25 bg-[#071B2B] p-6 text-[#EEEEEE] dark:border-[#B9E4E8]/25 dark:bg-[#051320]">
        <h2
          data-i18n="home.privacyTitle"
          class="text-xl font-bold text-[#B9E4E8]"
        >
          {en.home.privacyTitle}
        </h2>
        <p
          data-i18n="home.privacyBody"
          class="mt-2.5 text-sm leading-relaxed text-[#EEEEEE]/85 sm:text-base"
        >
          {en.home.privacyBody}
        </p>
      </article>
    </section>

    <!-- Use Cases Section -->
    <section aria-labelledby="use-cases-heading">
      <h2
        id="use-cases-heading"
        data-i18n="home.useCasesHeading"
        class="text-2xl font-extrabold tracking-tight text-[#071B2B] dark:text-[#EEEEEE]"
      >
        {en.home.useCasesHeading}
      </h2>
      <p
        data-i18n="home.useCasesIntro"
        class="mt-2 text-base text-[#455B6E] dark:text-[#A9C2D1]"
      >
        {en.home.useCasesIntro}
      </p>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="rounded-2xl border border-[#071B2B]/10 bg-white p-5 dark:border-[#B9E4E8]/15 dark:bg-[#0C273D]">
          <h3 data-i18n="home.useCase1Title" class="font-bold text-[#071B2B] dark:text-[#B9E4E8]">
            {en.home.useCase1Title}
          </h3>
          <p data-i18n="home.useCase1Body" class="mt-1.5 text-sm leading-relaxed text-[#455B6E] dark:text-[#A9C2D1]">
            {en.home.useCase1Body}
          </p>
        </div>

        <div class="rounded-2xl border border-[#071B2B]/10 bg-white p-5 dark:border-[#B9E4E8]/15 dark:bg-[#0C273D]">
          <h3 data-i18n="home.useCase2Title" class="font-bold text-[#071B2B] dark:text-[#B9E4E8]">
            {en.home.useCase2Title}
          </h3>
          <p data-i18n="home.useCase2Body" class="mt-1.5 text-sm leading-relaxed text-[#455B6E] dark:text-[#A9C2D1]">
            {en.home.useCase2Body}
          </p>
        </div>

        <div class="rounded-2xl border border-[#071B2B]/10 bg-white p-5 dark:border-[#B9E4E8]/15 dark:bg-[#0C273D]">
          <h3 data-i18n="home.useCase3Title" class="font-bold text-[#071B2B] dark:text-[#B9E4E8]">
            {en.home.useCase3Title}
          </h3>
          <p data-i18n="home.useCase3Body" class="mt-1.5 text-sm leading-relaxed text-[#455B6E] dark:text-[#A9C2D1]">
            {en.home.useCase3Body}
          </p>
        </div>

        <div class="rounded-2xl border border-[#071B2B]/10 bg-white p-5 dark:border-[#B9E4E8]/15 dark:bg-[#0C273D]">
          <h3 data-i18n="home.useCase4Title" class="font-bold text-[#071B2B] dark:text-[#B9E4E8]">
            {en.home.useCase4Title}
          </h3>
          <p data-i18n="home.useCase4Body" class="mt-1.5 text-sm leading-relaxed text-[#455B6E] dark:text-[#A9C2D1]">
            {en.home.useCase4Body}
          </p>
        </div>
      </div>
    </section>

    <!-- FAQs Section -->
    <section aria-labelledby="faq-heading">
      <h2
        id="faq-heading"
        data-i18n="home.faqHeading"
        class="text-2xl font-extrabold tracking-tight text-[#071B2B] dark:text-[#EEEEEE]"
      >
        {en.home.faqHeading}
      </h2>

      <div class="mt-6 space-y-3">
        {
          [1, 2, 3, 4, 5, 6].map((n) => {
            const qKey = `faq${n}Q` as keyof typeof en.home;
            const aKey = `faq${n}A` as keyof typeof en.home;
            return (
              <details
                open={n === 1}
                class="group rounded-2xl border border-[#071B2B]/10 bg-white px-5 py-4 dark:border-[#B9E4E8]/15 dark:bg-[#0C273D]"
              >
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-[#071B2B] dark:text-[#EEEEEE]">
                  <h3 data-i18n={`home.faq${n}Q`} class="text-sm sm:text-base">
                    {en.home[qKey]}
                  </h3>
                  <span class="shrink-0 text-lg font-normal text-[#167D8D] transition group-open:rotate-45 dark:text-[#B9E4E8]" aria-hidden="true">
                    +
                  </span>
                </summary>
                <p
                  data-i18n={`home.faq${n}A`}
                  class="mt-3 text-sm leading-relaxed text-[#455B6E] dark:text-[#A9C2D1]"
                >
                  {en.home[aKey]}
                </p>
              </details>
            );
          })
        }
      </div>
    </section>
  </div>
</BaseLayout>
